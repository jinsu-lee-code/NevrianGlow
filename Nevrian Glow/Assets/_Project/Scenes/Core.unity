  m_Script: {fileID: 11500000, guid: e2e9b516c9c9cd14a8e14cd199206497, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NevrianGlowFarm.UI.OpeningLetterScreen
  panel: {fileID: 1748199156}
  titleLabel: {fileID: 241399425}
  bodyLabel: {fileID: 1339467333}
  startButton: {fileID: 1104073589}
  closeActions:
  - {fileID: 3311173886053187834, guid: 052faaac586de48259a63d0c4782560b, type: 3}
  - {fileID: 7727032971491509709, guid: 052faaac586de48259a63d0c4782560b, type: 3}
  letterTitle: "\uB18D\uC7A5\uC5D0\uC11C \uC628 \uD3B8\uC9C0"
  letterBody: "\uC0C8 \uC8FC\uC778\uC5D0\uAC8C\n\n\uD669\uD63C\uC774 \uB05D\uB098\uC9C0
    \uC54A\uB294 \uC774 \uBCC4\uC758 \uB18D\uC7A5\uACFC \uC791\uC740 \uAC00\uAC8C\uB97C
    \uC774\uC81C \uB2F9\uC2E0\uC5D0\uAC8C \uB9E1\uAE41\uB2C8\uB2E4.\n\uC624\uB798
    \uBE44\uC6CC \uB454 \uD0D3\uC5D0 \uAC00\uAC8C\uB294 \uC5B4\uC9C8\uB7EC\uC838
    \uC788\uACE0 \uBC2D\uC740 \uAD73\uC5B4 \uC788\uC744 \uAC70\uC608\uC694.\n\n\uAD2D\uC774\uB85C
    \uBC2D\uC744 \uAC08\uACE0, \uC528\uC557\uC744 \uC2EC\uACE0, \uBB3C\uC744 \uC8FC\uC138\uC694.
    \uBC24\uC0AC\uC774 \uC791\uBB3C\uC774 \uBE5B\uC744 \uB0B4\uBA70 \uC790\uB78D\uB2C8\uB2E4.\n\uC218\uD655\uD55C
    \uC791\uBB3C\uC744 \uAC00\uAC8C\uC5D0 \uC9C4\uC5F4\uD558\uBA74 \uC190\uB2D8\uB4E4\uC774
    \uCC3E\uC544\uC62C \uAC70\uC608\uC694.\n\n\uC774 \uB18D\uC7A5\uC774 \uB2E4\uC2DC
    \uBE5B\uB098\uAE30\uB97C.\n\n\uC774\uC804 \uB18D\uC7A5 \uC8FC\uC778"
  startLabel: "\uB18D\uC7A5 \uC2DC\uC791\uD558\uAE30"

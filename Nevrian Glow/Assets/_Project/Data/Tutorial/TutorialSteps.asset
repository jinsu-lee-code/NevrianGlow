  letters:
  - id: letter_1
    title: "\uC598\uC57C, \uB18D\uC7A5\uC5D0 \uC628 \uCCAB\uB0A0 \uC5F4\uC5B4 \uBCF4\uB834"
    body: "\uC0AC\uB791\uD558\uB294 \uC6B0\uB9AC \uC598\uC57C,\n\n\uC774 \uD3B8\uC9C0\uB97C
      \uC77D\uACE0 \uC788\uB2E4\uBA74, \uD560\uBA38\uB2C8 \uB300\uC2E0 \uB124\uAC00
      \uAE00\uB85C\uC6B0 \uD31C\uC5D0 \uC640 \uC8FC\uC5C8\uAD6C\uB098. \uC815\uB9D0
      \uACE0\uB9D9\uB2E4.\n\uC624\uB7AB\uB3D9\uC548 \uC544\uBB34\uB3C4 \uB3CC\uBCF4\uC9C0
      \uBABB\uD574\uC11C \uBC2D\uB3C4 \uAC00\uAC8C\uB3C4, \uC800 \uB4F1\uB300\uB3C4
      \uB9CE\uC774 \uC4F8\uC4F8\uD574\uC84C\uC744 \uAC70\uC57C.\n\n<color=#8A3B12>\uAD2D\uC774\uB85C
      \uAD73\uC740 \uD759\uC744 \uBD80\uB4DC\uB7FD\uAC8C \uC77C\uAD6C\uACE0</color>,
      \uC6D4\uAD11 \uBFCC\uB9AC\uB97C \uC2EC\uC5B4 \uBCF4\uB834. \uBB3C\uB9CC \uC798
      \uC8FC\uBA74 \uD558\uB8FB\uBC24 \uC0AC\uC774\uC5D0 \uC608\uC058\uAC8C \uBE5B\uB09C\uB2E8\uB2E4.\n<color=#8A3B12>\uC606
      \uBC2D\uC5D0 \uC6D4\uAD11 \uBFCC\uB9AC \uC5EC\uC12F \uAC1C</color>\uB97C \uD0A4\uC6CC
      \uB450\uC5C8\uC5B4. \uC624\uB798 \uB450\uC5B4\uB3C4 \uC0C1\uD558\uC9C0 \uC54A\uAC70\uB4E0.
      \uAC00\uAC8C\uC5D0 \uB0B4\uB193\uC73C\uBA74 \uBC18\uAC00\uC6B4 \uC190\uB2D8\uC774
      \uC62C \uAC70\uC57C.\n\n\uCC9C\uCC9C\uD788, \uB124 \uC18D\uB3C4\uB300\uB85C
      \uD558\uBA74 \uB3FC.\n\uC5B8\uC81C\uB098 \uB124 \uD3B8\uC778, \uB124\uC544
      \uD560\uBA38\uB2C8\uAC00"
  - id: letter_2
    title: "\uC606\uC9D1 \uD53C\uD53C\uC758 \uD3B8\uC9C0"
    body: "\uC548\uB155\uD558\uC138\uC694! \uC606\uC9D1 \uD53C\uD53C\uC608\uC694.\n\n<color=#8A3B12>\uC5B4\uC81C
      \uD560\uBA38\uB2C8\uC758 \uAC00\uAC8C\uAC00 \uB2E4\uC2DC \uC5F4\uB824\uC11C
      \uBBF8\uB8E8\uB791 \uC640 \uBD24\uC5B4\uC694~</color> \uC6D4\uAD11 \uBFCC\uB9AC
      \uC815\uB9D0 \uBC18\uC9DD\uBC18\uC9DD\uD558\uACE0 \uB9DB\uC788\uC5C8\uC5B4\uC694!\n\uC5C4\uB9C8\uAC00
      \uADF8\uB7EC\uB294\uB370, \uC61B\uB0A0\uC5D0 \uD560\uBA38\uB2C8 \uAC00\uAC8C\uC5D0\uB294
      <color=#8A3B12>\uBC84\uC12F\uAF43\uC774\uB791 \uB4F1\uBD88 \uC5F4\uB9E4</color>\uB3C4
      \uC788\uC5C8\uB300\uC694. \uC624\uB298\uC740 \uC0C1\uC810\uC5D0 \uB4E4\uC5B4\uC654\uC744\uAE4C\uC694?\n\uBC84\uC12F\uAF43\uC740
      \uBB3C\uC744 \uC548 \uC918\uB3C4 \uC465\uC465 \uC790\uB780\uB300\uC694. \uC2E0\uAE30\uD558\uC8E0?\n\n\uB610
      \uB180\uB7EC \uAC08\uAC8C\uC694! - \uD53C\uD53C (\uBBF8\uB8E8\uB3C4 \uC548\uB155\uC774\uB798\uC694)"
  - id: letter_3
    title: "\uC624\uB974 \uC544\uC8FC\uBA38\uB2C8\uC758 \uD3B8\uC9C0"
    body: "\uC0C8 \uC815\uC6D0\uC9C0\uAE30\uB2D8\uAED8,\n\n\uC5B4\uC82F\uBC24 \uCC3D\uBC16\uC744
      \uBCF4\uB2E4\uAC00 \uAE5C\uC9DD \uB180\uB790\uC5B4\uC694. <color=#8A3B12>\uB4F1\uB300
      \uC544\uB798\uCE35\uC5D0 \uBD88\uC774 \uB4E4\uC5B4\uC654\uB354\uAD70\uC694.</color>
      \uBA87 \uD574 \uB9CC\uC778\uC9C0 \uBAB0\uB77C\uC694.\n\uC624\uB298 \uC544\uCE68\uC5D4
      \uBC2D \uB458\uB808 \uD480\uC774 \uCD08\uB85D\uBE5B\uC774\uB354\uB77C\uACE0\uC694.
      \uB124\uC544 \uD560\uBA38\uB2C8\uAC00 \uACC4\uC2E4 \uB54C\uCC98\uB7FC\uC694.\n\uD560\uBA38\uB2C8\uB294
      \uB298 <color=#8A3B12>\uD2BC\uD2BC\uD55C \uCCA0 \uAD2D\uC774</color>\uB85C
      \uBC2D\uC744 \uC77C\uAD6C\uC168\uC5B4\uC694. <color=#8A3B12>\uBC2D\uC744 \uBE48
      \uACF3 \uC5C6\uC774 \uCC44\uC6B0\uBA74</color> \uB4F1\uB300\uB3C4 \uB354 \uBC1D\uC544\uC9C8
      \uAC70\uC608\uC694.\n\n\uC774\uC6C3 \uC624\uB974 \uB4DC\uB9BC"
  - id: letter_4
    title: "\uC2DC\uC7A5 \uC0C1\uC778 \uBC14\uB8E8\uC758 \uD3B8\uC9C0"
    body: "\uAE00\uB85C\uC6B0 \uD31C \uC8FC\uC778\uC7A5\uC5D0\uAC8C,\n\n\uC18C\uBB38
      \uB4E4\uC5C8\uC18C. \uBC84\uC12F\uAF43\uC774 \uB2E4 \uC790\uB790\uB2E4\uBA74\uC11C?
      \uC624\uB298\uC740 \uC190\uB2D8\uC774 \uAF64 \uBAB0\uB9B4 \uAC70\uC694.\n\uC7A5\uC0AC\uAFBC\uC73C\uB85C\uC11C
      \uD55C\uB9C8\uB514 \uD558\uC790\uBA74, \uC774\uB7F0 \uB0A0\uC5D4 <color=#8A3B12>\uBC2D\uC744
      \uB113\uD600 \uB450\uB294 \uAC8C</color> \uB0A8\uB294 \uC7A5\uC0AC\uC694. <color=#8A3B12>\uAC04\uD310\uC744
      \uB2E4\uC2DC \uB2EC\uC544 \uD64D\uBCF4</color>\uD558\uAC70\uB098 <color=#8A3B12>\uC7A5\uBC14\uAD6C\uB2C8\uB97C
      \uD070 \uAC78\uB85C</color> \uBC14\uAFB8\uBA74 \uC190\uB2D8\uC774 \uB354 \uB9CE\uC774
      \uC0AC \uAC00\uC9C0.\n\uADF8\uB9AC\uACE0 \uD560\uBA38\uB2C8\uAC00 \uC544\uB07C\uB358
      <color=#8A3B12>\uBE44\uB8CC</color>, \uB4F1\uBD88 \uC5F4\uB9E4 \uB098\uBB34\uC5D0
      \uD55C \uC90C \uC8FC\uBA74 \uAE08\uBC29 \uC5F4\uB9E4\uAC00 \uB9FA\uD78C\uB2E4\uB354\uAD70.\n\n\uC2DC\uC7A5
      \uAC70\uB9AC\uC758 \uBC14\uB8E8"
  - id: letter_5
    title: "\uD53C\uD53C\uC758 \uD3B8\uC9C0"
    body: "\uC815\uC6D0\uC9C0\uAE30 \uC5B8\uB2C8(\uC624\uBE60)! \uD53C\uD53C\uC608\uC694!\n\n<color=#8A3B12>\uB4F1\uB300
      2\uCE35\uC5D0\uB3C4 \uBD88\uC774 \uCF1C\uC84C\uC5B4\uC694!</color> \uB098\uBB34\uC5D0
      \uAF43\uC774 \uD53C\uACE0, \uC800\uB141\uC5D4 \uBC18\uB527\uBD88\uC774\uAC00
      \uB0A0\uC544\uB2E4\uB140\uC694. \uC0C8\uB3C4 \uB3CC\uC544\uC654\uC5B4\uC694!\n\uBBF8\uB8E8\uAC00
      \uADF8\uB7EC\uB294\uB370, \uD560\uBA38\uB2C8\uB294 <color=#8A3B12>\uBC18\uC9DD\uC774\uB294
      \uB300\uAC78\uB808\uB791 \uD070 \uBB3C\uBFCC\uB9AC\uAC1C</color>\uB97C \uC4F0\uC168\uB300\uC694.
      <color=#8A3B12>\uAC00\uBC29\uC774 \uD06C\uBA74</color> \uC218\uD655\uD55C \uAC78
      \uD55C \uBC88\uC5D0 \uB9CE\uC774 \uC62E\uAE38 \uC218 \uC788\uACA0\uC8E0?\n\n\uC624\uB298\uB3C4
      \uAC00\uAC8C\uC5D0 \uAC08\uAC8C\uC694~ - \uD53C\uD53C"
  - id: letter_6
    title: "\uB4F1\uB300 \uC544\uB798\uCE35\uC774 \uB2E4 \uBC1D\uC544\uC9C4 \uB0A0
      \uC5F4\uC5B4 \uBCF4\uB834"
    body: "\uC6B0\uB9AC \uC598\uC57C,\n\n\uC774 \uD3B8\uC9C0\uB97C \uC5F4\uC5C8\uB2E4\uBA74,
      \uB4F1\uB300\uC5D0 \uB2E4\uC2DC \uBD88\uC774 \uB4E4\uC5B4\uC624\uAE30 \uC2DC\uC791\uD588\uAD6C\uB098.
      \uB4F1\uBD88 \uC5F4\uB9E4 \uB098\uBB34\uC5D0\uB3C4 <color=#8A3B12>\uCCAB \uC5F4\uB9E4</color>\uAC00
      \uB9FA\uD614\uC744 \uAC70\uC57C.\n\uC624\uB298 \uC7A5\uC0AC\uB97C \uB9C8\uCE58\uBA74,
      <color=#8A3B12>\uB4F1\uB300\uB97C \uAF2D \uC62C\uB824\uB2E4\uBCF4\uB834.</color>
      \uD560\uBA38\uB2C8\uAC00 \uC624\uB798 \uAE30\uB2E4\uB9B0 \uC21C\uAC04\uC774\uB780\uB2E4.\n\n\uC774\uC81C
      \uAE00\uB85C\uC6B0 \uD31C\uC740 \uB124 \uB18D\uC7A5\uC774\uC57C. \uB124 \uB9C8\uC74C
      \uAC00\uB294 \uB300\uB85C \uAC00\uAFD4 \uC8FC\uB834.\n\uB124\uC544 \uD560\uBA38\uB2C8\uAC00"
